<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The page picks its own theme (Parchment or Lamplight), so the shell stays light. -->
    <style name="Theme.SW" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="Theme.SW.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SW</item>
    </style>
</resources>
