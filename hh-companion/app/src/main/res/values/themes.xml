<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HH" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <!-- WebView maps this to prefers-color-scheme, which drives the page's "system" theme. -->
        <item name="android:isLightTheme" tools:targetApi="29">true</item>
    </style>

    <style name="Theme.HH.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HH</item>
    </style>
</resources>
